# Loaded in every environment; .env.local, .env.$APP_ENV and real environment
# variables override it. Never put a production secret here or in any other
# committed file: https://symfony.com/doc/current/configuration/secrets.html

APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share

# Where URLs are generated outside a request, in a console command.
DEFAULT_URI=http://localhost

# PostgreSQL. compose.yaml runs one for development on this address.
DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=17&charset=utf8"

# Mail. null://null sends nothing, and the pages that would send a link say
# so. Set a transport (smtp://user:pass@host:587, a provider's DSN) and the
# address mail comes from in .env.local.
###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###
MAILER_FROM="vivutio <no-reply@localhost>"
